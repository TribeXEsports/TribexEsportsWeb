datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  username      String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER") // SUPER_ADMIN | ORGANIZER | CAPTAIN | PLAYER | USER

  accounts      Account[]
  sessions      Session[]
  
  createdAt     DateTime? @default(now())
  updatedAt     DateTime? @updatedAt
  
  // Social Connectivity
  twitterUrl     String?
  instagramUrl   String?
  youtubeUrl     String?
  
  // Relations
  managedTeams   Team[]         @relation("Captain")
  joinedTeams    Team[]         @relation(fields: [teamIds], references: [id])
  teamIds        String[]       @db.ObjectId
  
  registrations  Registration[]
  tournaments    Tournament[]   @relation("EventOrganizer") // Events this organizer created
  
  // Direct match relationships
  matchesA       Match[]        @relation("UserA")
  matchesB       Match[]        @relation("UserB")
  wonMatches     Match[]        @relation("WinnerUser")
}

model Team {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  image       String?
  
  captainId   String   @db.ObjectId
  captain     User     @relation("Captain", fields: [captainId], references: [id])
  
  memberIds   String[] @db.ObjectId
  members     User[]   @relation(fields: [memberIds], references: [id])
  
  rosterLimit Int      @default(5)
  
  registrations Registration[]
  matchesA      Match[]        @relation("TeamA")
  matchesB      Match[]        @relation("TeamB")
  wonMatches    Match[]        @relation("WinnerTeam")
  disputes      Dispute[]
}

model Tournament {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  
  // Core Event Config
  title       String
  description String?
  type        String   @default("TOURNAMENT") // TOURNAMENT | SCRIM
  game        String   // Free Fire | BGMI | Valorant
  mode        String   // BR | CS | TDM | 5v5
  teamFormat  String?  // SOLO | DUO | SQUAD | 5v5
  
  // Organizer Link
  organizerId String?  @db.ObjectId
  organizer   User?    @relation("EventOrganizer", fields: [organizerId], references: [id])
  
  // Logistics
  maxPlayers       Int
  teamsPerMatch    Int?
  numberOfGroups   Int?
  matchesPerGroup  Int?
  startTime           DateTime
  registrationEndTime DateTime?
  endTime             DateTime?
  status           String   @default("UPCOMING") // UPCOMING | REGISTRATION | LIVE | COMPLETED
  imageUrl         String?
  allowSubstitutes Boolean  @default(false)
  isFeatured       Boolean  @default(false)
  
  // Monetization
  entryType   String   @default("FREE") // FREE | PAID
  entryFee    Int      @default(0)
  prizePool   String?
  
  // Dynamic Game Rules
  pointsSystem Json?
  rules        String?
  
  // Legacy Data Handlers
  winnerName      String?
  winnerId        String?
  resultsOverview String?
  finalStandings  Json?
  
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt

  // Game Intelligence
  gameType        String?   // FF, BGMI, VALORANT
  bracketType     String?   // SWISS, SINGLE_ELIM, DOUBLE_ELIM, ROUND_ROBIN
  mapPool         String[]  
  pointsPreset    String?   // FFWS, BGIS, VCT
  vetoSystem      Boolean?  @default(false)
  wildcardEnabled Boolean?  @default(false)
  agentBansEnabled Boolean? @default(false)
  targetFinalSize   Int?      @default(12)
  autoVerify        Boolean   @default(true)
  
  registrations Registration[]
  matches       Match[]
}

model Registration {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  tournamentId String      @db.ObjectId
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  
  userId       String?     @db.ObjectId
  user         User?       @relation(fields: [userId], references: [id])
  
  teamId       String?     @db.ObjectId
  team         Team?       @relation(fields: [teamId], references: [id])
  
  captainId    String?     @db.ObjectId
  
  // Statuses: PENDING_APPROVAL | VERIFIED | PAYMENT_PENDING | REJECTED | WITHDRAWN
  status       String      @default("PENDING_APPROVAL")
  
  // Detailed Player Data (UIDs, Riot IDs, IGNs)
  rosterData   Json?       
  
  // Payment Tracking
  paymentId       String?
  paymentStatus   String      @default("PENDING") // PENDING | COMPLETED | FAILED
  gatewayUsed     String      @default("NONE")     // RAZORPAY | CASHFREE | MANUAL
  transactionId   String?     // External Reference (Order ID or Tx ID)
  
  createdAt    DateTime? @default(now())

  // NEXUS Post-Registration Fields
  lobby        String?   
  slot         Int?
  isManualAdded Boolean  @default(false)

  // Data Integrity 
  registryKey  String?   @unique
}

model Match {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  tournamentId String      @db.ObjectId
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  
  stage        String?     // e.g. "Group A" or "Semi-Finals"
  
  teamAId      String?     @db.ObjectId
  teamA        Team?       @relation("TeamA", fields: [teamAId], references: [id])
  
  teamBId      String?     @db.ObjectId
  teamB        Team?       @relation("TeamB", fields: [teamBId], references: [id])
  
  userAId      String?     @db.ObjectId
  userA        User?       @relation("UserA", fields: [userAId], references: [id])
  
  userBId      String?     @db.ObjectId
  userB        User?       @relation("UserB", fields: [userBId], references: [id])
  
  scoreA       Int         @default(0)
  scoreB       Int         @default(0)
  roundResults Json?       // Explicit round history
  
  winnerTeamId String?     @db.ObjectId
  winnerTeam   Team?       @relation("WinnerTeam", fields: [winnerTeamId], references: [id])
  
  winnerUserId String?     @db.ObjectId
  winnerUser   User?       @relation("WinnerUser", fields: [winnerUserId], references: [id])
  
  status       String      @default("PENDING") // PENDING | LIVE | SUBMITTED | DISPUTED | CONFIRMED
  
  map          String?
  vetoData     Json?

  room         Room?
  disputes     Dispute[]
  
  createdAt    DateTime? @default(now())
}

model Room {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  matchId      String    @unique @db.ObjectId
  match        Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  
  roomId       String?
  roomPassword String?
  map          String?
  revealTime   DateTime?
  visibility   String    @default("PRIVATE") // PRIVATE | PUBLIC
  notes        String?   // E.g. Valorant custom lobby instructions
}

model Dispute {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  matchId      String    @db.ObjectId
  match        Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  
  teamId       String    @db.ObjectId
  team         Team      @relation(fields: [teamId], references: [id])
  
  reason       String
  description  String
  screenshots  String[]
  
  status       String    @default("UNDER_REVIEW") // UNDER_REVIEW | RESOLVED
  resolution   String?   // OVERTURNED | UPHELD | REPLAY
  
  createdAt    DateTime? @default(now())
}

model Payment {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  transactionId String?   @unique
  gateway       String    // RAZORPAY | CASHFREE | PHONEPE | MANUAL
  amount        Int
  status        String    @default("PENDING") // PENDING | SUCCESS | FAILED
  userId        String    @db.ObjectId
  teamId        String?   @db.ObjectId
  tournamentId  String    @db.ObjectId
  metadata      Json?
  
  createdAt     DateTime? @default(now())
  updatedAt     DateTime? @updatedAt
}

model SiteSettings {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  siteName          String?  @default("Tribex")
  siteSubtitle      String?  @default("Esports")
  heroBackgroundUrl String?
  heroVideoUrl      String?
  heroTitle         String?
  heroSubtitle      String?
  heroTagline       String?
  heroCtaText       String?  @default("ENTER ARENA")
  heroCtaTextGuest  String?  @default("SIGN UP NOW")
  heroBadgeText     String?  @default("Live Arena")
  footerDescription String?  @default("Pioneering high-performance digital solutions. Built for speed, security, and digital dominance.")
  heroVideoBrightness Int?     @default(75)
  heroOverlayOpacity  Int?     @default(30)
  heroOverlayColor    String?  @default("#000000")
  heroVideoGrayscale  Boolean? @default(false)
  logoUrl           String?
  whatsappUrl       String?
  discordUrl        String?
  twitterUrl        String?
  instagramUrl      String?
  youtubeUrl        String?
  githubUrl         String?
  
  contactEmail      String?  @default("support@tribexesports.cloud")
  contactPhone      String?  @default("+91 00000 00000")
  contactAddress    String?  @default("Esports HQ, Digital City")

  aboutStatTournaments  String?  @default("50+")
  aboutStatPlayers      String?  @default("2500+")
  aboutStatPrize        String?  @default("₹1.2L+")
  aboutStatGames        String?  @default("4+")
  
  cloudinaryCloudName    String?
  cloudinaryUploadPreset String?
  
  logoItalic          Boolean? @default(true)
  heroItalic          Boolean? @default(true)
  headingsItalic      Boolean? @default(true)
  tagsItalic          Boolean? @default(true)
  navbarItalic        Boolean? @default(true)
  dashboardBtnItalic   Boolean? @default(false)

  phasesTitle         String?  @default("Operational")
  phasesSubtitle      String?  @default("Phases.")
  arenaTitle          String?  @default("Join the")
  arenaSubtitle       String?  @default("Arena.")
  faqTitle            String?  @default("FREQUENTLY ASKED")
  faqSubtitle         String?  @default("QUESTIONS")

  totalPrizeMoney          Int?     @default(0)
  totalRegisteredTeamsBase Int?     @default(0)
  gameCardHeight           Int?     @default(220)
  gameCardSpeed            Int?     @default(30)
  freefireApiUrl           String?  @default("https://tribexapi.vercel.app")
  
  // ----------------------------------------------------
  // MULTI-GATEWAY SYSTEM
  // ----------------------------------------------------
  activeGateway     String?  @default("RAZORPAY") // RAZORPAY | CASHFREE | PHONEPE
  
  razorpayKeyId     String?
  razorpayKeySecret String?
  
  cashfreeAppId     String?
  cashfreeSecretKey String?
  cashfreeEnv       String?  @default("SANDBOX") // SANDBOX | PRODUCTION
  
  phonepeMerchantId String?
  phonepeSaltKey    String?
  phonepeSaltIndex  String?  @default("1")
  phonepeEnv        String?  @default("UAT") // UAT | PRODUCTION
  freefireApiEnabled Boolean? @default(true)

  updatedAt         DateTime? @updatedAt
}

model RosterMember {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  role      String
  game      String
  teamName  String?
  imageUrl  String?
  stats     String?
  createdAt DateTime? @default(now())
}

model CampusAmbassador {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  university String
  imageUrl   String?
  createdAt  DateTime? @default(now())
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model News {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  content     String
  imageUrl    String?
  category    String   // ANNOUNCEMENT | MATCH_UPDATE | COMMUNITY
  author      String   @default("Admin")
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
}

model FeaturedGame {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  imageUrl  String
  order     Int      @default(0)
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

model Partner {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  role      String
  category  String
  order     Int      @default(0)
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

model PopupNotification {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  message       String
  imageUrl      String?
  link          String?    // Custom link or tournament link
  linkText      String   @default("Learn More")
  type          String   @default("CUSTOM") // CUSTOM | TOURNAMENT
  tournamentId  String?  @db.ObjectId
  isActive      Boolean  @default(true)
  showOnce      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
